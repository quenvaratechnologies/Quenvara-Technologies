# Quenvara Technology — environment variable NAMES only. Copy to .env.local and fill in.
# Never commit real values. Variables without NEXT_PUBLIC_ are server-only.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # anon / publishable key (safe for the browser; protected by RLS)
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY. Used for public form submissions, signed URLs, provisioning.

# --- Site ---
SITE_URL=http://localhost:3000        # canonical origin; used for metadata, sitemap, CSRF origin check
NEXT_PUBLIC_SITE_URL=                 # optional; falls back to SITE_URL

# --- Email notifications (optional; Resend HTTP API). Disabled unless all three are set ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=                           # e.g. "Quenvara <noreply@your-domain>" (a verified sender)
EMAIL_NOTIFY_TO=                      # inbox that receives new inquiry / application notifications

# --- Optional ---
REVALIDATE_SECRET=                    # reserved for webhook-triggered revalidation
